#!/usr/bin/env python3
"""Run the quality gate a ticket requires and write a report. See docs/development/quality-gates.md."""
import argparse
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts/quality"))
import gates  # noqa: E402
import runner  # noqa: E402
import distributed  # noqa: E402
import json  # noqa: E402


def main():
    parser = argparse.ArgumentParser(
        description="Run the canonical ticket's local gate: the host gate G1 (G3 whole for a release ticket); the hosted run adds the device suites. Checks cannot be skipped or downgraded.",
    )
    parser.add_argument("--affected", metavar="BASE", help="Local ticket: run its device gate with the device modules affected since BASE; the default runs the host gate only.")
    parser.add_argument("--ci-plan", metavar="BASE", help="Print the exact hosted plan, including gate and selected groups.")
    parser.add_argument("ticket", nargs="?", help="Ticket ID, for example SELLO-017")
    parser.add_argument(
        "--merge-candidate", metavar="BASE",
        help="CI mode: verify every ticket advanced since BASE, or the bare gate if none is.",
    )
    parser.add_argument(
        "--candidate-gate", metavar="BASE",
        help="CI: print the gate a merge candidate needs (G0 for documents only, otherwise G2) and exit.",
    )
    parser.add_argument(
        "--landed", metavar="BASE",
        help="CI on main: run the host gate on what merged since BASE; its own gate ran before the merge.",
    )
    parser.add_argument(
        "--gate", choices=gates.GATES[1:],
        help="Run a higher gate than the local default, for example G2 to run every device suite locally. A lower one is refused.",
    )
    parser.add_argument(
        "--retain", action="store_true",
        help="After a passed run, copy the report into the ticket folder as quality-report.json and print the Quality run field.",
    )
    ci = parser.add_mutually_exclusive_group()
    ci.add_argument("--ci-part", choices=distributed.PARTS, help="Execute one CI part; this is not full-gate evidence.")
    ci.add_argument("--ci-collect", metavar="DIRECTORY", help="Validate all CI parts and write full-gate reports.")
    parser.add_argument("--ci-event", choices=distributed.EVENTS, help="CI event policy; defaults to GITHUB_EVENT_NAME.")
    parser.add_argument("--ci-output", metavar="DIRECTORY", help="Fresh output root for --ci-part.")
    arguments = parser.parse_args()
    modes = [arguments.ticket, arguments.merge_candidate, arguments.candidate_gate, arguments.landed, arguments.ci_plan]
    if sum(bool(mode) for mode in modes) != 1:
        parser.error("give exactly one of: a ticket ID, --merge-candidate, --candidate-gate, --landed, --ci-plan")
    if arguments.retain and not arguments.ticket:
        parser.error("--retain needs a ticket ID")
    if arguments.affected and (not arguments.ticket or arguments.ci_part or arguments.ci_collect):
        parser.error("--affected needs a local ticket ID")
    if arguments.ci_plan:
        if arguments.gate or arguments.retain or arguments.affected or arguments.ci_part or arguments.ci_collect or arguments.ci_output:
            parser.error("--ci-plan cannot execute or retain a gate")
        try:
            print(json.dumps(distributed.context(ROOT, arguments.ci_plan, arguments.ci_event or os.environ.get("GITHUB_EVENT_NAME"))))
            return 0
        except (runner.Refusal, gates.Unavailable, ValueError, OSError) as error:
            print(f"REFUSED: {error}", file=sys.stderr)
            return 2
    ci_mode = arguments.ci_part or arguments.ci_collect
    if ci_mode and (not arguments.merge_candidate or arguments.gate or arguments.retain):
        parser.error("CI parts/collection require --merge-candidate and derive their gate; --gate/--retain are not allowed")
    if arguments.ci_output and not arguments.ci_part:
        parser.error("--ci-output needs --ci-part")
    if arguments.ci_event and not ci_mode:
        parser.error("--ci-event needs --ci-part or --ci-collect")
    if ci_mode:
        event = arguments.ci_event or os.environ.get("GITHUB_EVENT_NAME")
        if arguments.ci_part:
            return distributed.run_part(
                ROOT, arguments.merge_candidate, event, arguments.ci_part,
                output=arguments.ci_output or distributed.PART_DIRECTORY,
            )[0]
        return distributed.collect(ROOT, arguments.merge_candidate, event, arguments.ci_collect)[0]
    if arguments.candidate_gate:
        if arguments.gate:
            parser.error("--candidate-gate takes no --gate")
        print(runner.candidate_gate(ROOT, arguments.candidate_gate))
        return 0
    if arguments.landed:
        if arguments.gate:
            parser.error("--landed takes no --gate: it always runs the host gate")
        return runner.run_landed(arguments.landed, ROOT)[0]
    if arguments.merge_candidate:
        return runner.run_merge_candidate(arguments.merge_candidate, ROOT, requested_gate=arguments.gate)[0]
    return runner.run(arguments.ticket, ROOT, requested_gate=arguments.gate, retain=arguments.retain, affected_base=arguments.affected)[0]


if __name__ == "__main__":
    sys.exit(main())
