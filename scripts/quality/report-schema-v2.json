{
  "$comment": "Sello report v2: explicit full/affected/documentation coverage. Historical v1 stays supported.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "ticket",
    "gate",
    "outcome",
    "failures",
    "warnings",
    "snapshot",
    "environment",
    "devices",
    "checks",
    "started_at",
    "finished_at",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "ticket": {
      "type": "string",
      "pattern": "^(SELLO-[0-9]{3}|UNTICKETED)$"
    },
    "gate": {
      "type": "object",
      "required": [
        "required",
        "executed"
      ],
      "properties": {
        "required": {
          "enum": [
            "G0",
            "G1",
            "G2",
            "G3"
          ]
        },
        "executed": {
          "enum": [
            "G0",
            "G1",
            "G2",
            "G3"
          ]
        }
      }
    },
    "outcome": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "head",
        "dirty",
        "dirty_files",
        "fingerprint",
        "acceptance"
      ],
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "dirty_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fingerprint": {
          "type": "object",
          "required": [
            "algorithm",
            "value",
            "files"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "files": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "acceptance": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "changes": {
          "type": "object",
          "required": [
            "algorithm",
            "base",
            "value",
            "paths"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "base": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "paths": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "environment": {
      "type": "object"
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "serial",
          "api",
          "model"
        ],
        "properties": {
          "serial": {
            "type": "string"
          },
          "api": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "command",
          "log",
          "exit_code",
          "started_at",
          "finished_at"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "log": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "started_at": {
            "type": "string"
          },
          "finished_at": {
            "type": "string"
          },
          "results": {
            "type": "object"
          },
          "lint": {
            "type": "object"
          },
          "modules": {
            "type": "object"
          },
          "shard": {
            "type": "object",
            "required": [
              "index",
              "count"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "count": {
                "type": "integer",
                "minimum": 2
              }
            }
          }
        }
      }
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "coverage": {
      "type": "object",
      "required": [
        "mode",
        "base",
        "changed_paths",
        "device_modules"
      ],
      "properties": {
        "mode": {
          "enum": [
            "full",
            "affected",
            "documents"
          ]
        },
        "base": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "device_modules": {
          "type": "array",
          "items": {
            "enum": [
              "data",
              "design-system",
              "app",
              "catalog"
            ]
          }
        }
      }
    }
  }
}
